# Copy this file to .env and fill in the placeholder values.
# backend/.env is gitignored - never commit it.

# --- Common ---
FRONTEND_URL="http://localhost:4200"
ENVIRONMENT="local"
LOG_LEVEL="INFO"

# --- Project (must match dev-infra Terraform) ---
PROJECT_ID="mbaneshi-cstudio-2025"
GOOGLE_CLOUD_PROJECT="mbaneshi-cstudio-2025"
GENMEDIA_BUCKET="mbaneshi-cstudio-2025-cs-development-bucket"
SIGNING_SA_EMAIL="cs-development-read@mbaneshi-cstudio-2025.iam.gserviceaccount.com"

# --- Auth ---
GOOGLE_TOKEN_AUDIENCE="519791639027-b6roarvttsjigu0de3qu0n96apcb20ov.apps.googleusercontent.com"
IDENTITY_PLATFORM_ALLOWED_ORGS=""

# --- Database (Option A: Cloud SQL - requires Terraform applied) ---
INSTANCE_CONNECTION_NAME="mbaneshi-cstudio-2025:us-central1:REPLACE_WITH_INSTANCE_NAME"
USE_CLOUD_SQL_AUTH_PROXY=false
DB_USER="postgres"
DB_PASS="REPLACE_WITH_DB_PASSWORD"
DB_NAME="creative_studio"

# --- Database (Option B: Local Postgres - uncomment and use if Terraform not run yet) ---
# INSTANCE_CONNECTION_NAME=""
# DB_HOST="localhost"
# DB_PORT="5432"
# DB_USER="postgres"
# DB_PASS="your_local_postgres_password"
# DB_NAME="creative_studio"
